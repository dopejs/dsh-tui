{
  "name": "@dopejs/dsh-tui",
  "version": "0.0.0",
  "description": "A plugin-native terminal user interface for DeepSeek Harness",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dopejs/dsh-tui.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm check:docs && pnpm lint && pnpm typecheck && pnpm test",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@eslint/js": "10.0.1",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@types/node": "22.19.20",
    "@types/react": "19.2.18",
    "@types/terminal-kit": "2.5.7",
    "eslint": "10.8.1",
    "terminal-kit": "3.1.4",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
